# ============================================================================
# Formación U.G.–U.S. — variables de entorno
# ============================================================================
# Copia este fichero a `.env.local` y rellena los valores TÚ MISMO.
# `.env.local` está ignorado por git. NUNCA subas credenciales al repositorio.
#
# Este proyecto debe ser un Firebase PROPIO de Formación. No reutilices el
# proyecto de la aplicación de cuadrantes.
#
# Proyecto previsto: `formacionus-63555` — Firestore en modo nativo, base de datos
# `(default)`, ubicación europe-southwest1 (Madrid). Todo lo que usa la
# aplicación funciona en el plan Spark (gratuito): no se usan Storage, Cloud
# Functions, App Hosting ni backups gestionados.
# ============================================================================

# ---------------------------------------------------------------- Servidor
# Secreto: descárgalo de la consola de Firebase (Cuentas de servicio).
FIREBASE_PROJECT_ID=formacionus-63555
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Los PDF NO usan Firebase Storage (el plan Spark no lo incluye). Se guardan
# fragmentados en Firestore y solo los sirve este servidor. Presupuesto máximo
# para PDF en MiB; se acota automáticamente al máximo seguro de la cuota
# gratuita (1 GiB menos 128 MiB de reserva). 512 es un buen punto de partida.
PDF_STORAGE_BUDGET_MB=512

# Dominio interno de los correos sintéticos. Usa un TLD reservado (.invalid):
# no es enrutable y evita enviar correo por accidente.
AUTH_EMAIL_DOMAIN=formacion.invalid

# Origen público (para comprobar el origen de las peticiones que escriben).
# En local: http://localhost:3000
# En producción es OBLIGATORIO y debe ser https (la aplicación no arranca sin
# él): es la referencia para rechazar peticiones de otros dominios (CSRF).
APP_ORIGIN=http://localhost:3000

# Nombre de la cookie de sesión. En producción debe empezar por `__Host-`
# (obligatorio: la aplicación no arranca si no lo cumple). El prefijo impide
# que un subdominio sobrescriba la cookie; exige Secure, Path=/ y sin Domain,
# que es exactamente como se emite.
SESSION_COOKIE_NAME=formacion_session
# SESSION_COOKIE_NAME=__Host-formacion_session   ← valor para producción
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------- Comprobación
# Tras rellenar el fichero, comprueba la conexión SIN escribir nada:
#   npm run check:firebase
# Exit 0 = todo responde · 2 = falta configuración · 3 = no responde o sin permiso.

# ---------------------------------------------------------------- Demostración
# DEMO_MODE=1 arranca la aplicación con datos INVENTADOS en memoria: sin
# Firebase, sin cuentas reales y sin documentos. Sirve para enseñar la
# interfaz; al reiniciar el servidor todo vuelve al estado inicial.
# Déjalo vacío para el funcionamiento normal (Firebase obligatorio).
#   DEMO_MODE=1 npm run dev
DEMO_MODE=

# ---------------------------------------------------------------- Emuladores
# Déjalas vacías salvo que estés usando los emuladores en local.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# ---------------------------------------------------------------- Cliente
# La configuración web de Firebase NO es un secreto (va en el bundle del
# navegador), pero debe pertenecer al proyecto de Formación.
#
# Aun siendo pública, NO se pega en un chat, ni en un informe, ni en un
# documento: se escribe en el entorno de ejecución (variables del proveedor de
# despliegue o tu `.env.local` local) y se comprueba con `npm run check:web`,
# que informa del resultado sin repetir los valores.
#
# Plantilla vacía: este fichero es la plantilla. Rellena los cinco valores en la
# copia (`.env.local`), nunca aquí: `.env.example` se versiona.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=formacionus-63555
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=formacion.invalid

# ---------------------------------------------------------------- Arranque
# Lista inicial de administradores para el script de arranque, separada por
# comas: "rol1.apellido,rol1.otroapellido". NO se usa en la importación normal.
BOOTSTRAP_ADMIN_USERNAMES=
